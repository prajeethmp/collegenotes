# ==============================================================================
# StudyNexus - Environment Variables Configuration
# ==============================================================================

# 1. JWT Secret for Session Signing (Generate a random 32+ character string)
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_2026

# 2. Database Connection (MongoDB Atlas free tier M0 cluster recommended for Vercel)
# If left empty, StudyNexus runs on a local JSON file database for instant testing.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=studynexus

# 3. File Storage Options for Vercel:
# OPTION A: Vercel Blob (Recommended on Vercel: 1-click in Vercel Storage tab)
BLOB_READ_WRITE_TOKEN=

# OPTION B: Cloudinary (Free 25GB storage for PDFs, images, docs, and any format)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Note: If no cloud storage keys are configured, files under 4.5MB are stored 
# automatically using resilient base64 data URIs, working 100% out of the box!
